# Exemplo SEM valores reais. Copie para .env (nao versionado).
HOST=127.0.0.1

# --- Docker Compose de desenvolvimento (FND-004) ---
# As credenciais dos servicos Compose continuam em infrastructure/docker/.env.local
# (nao versionado), geradas por infrastructure/docker/scripts/gerar-segredos.sh.
# A configuracao da API e da Hotmart fica na secao do MVP abaixo.
# Portas de host (todas publicadas apenas em 127.0.0.1); valores abaixo sao os padroes.
PG_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# Financeiro: valores secretos apenas no ambiente local ou *_FILE, nunca em NEXT_PUBLIC_*.
# HOTMART_WEBHOOK_HOTTOK_FILE=
# MINIO_ENDPOINT=http://127.0.0.1:19000
# MINIO_FINANCEIRO_BUCKET=nucleos-financeiro
# MINIO_ACCESS_KEY_FILE=
# MINIO_SECRET_KEY_FILE=
MAILPIT_SMTP_HOST_PORT=11025
MAILPIT_UI_HOST_PORT=18025
PROXY_HOST_PORT=18080
OTLP_GRPC_HOST_PORT=14317
OTLP_HTTP_HOST_PORT=14318
OTEL_HEALTH_HOST_PORT=13133

# --- Configuracao tradicional do MVP (ADR-020 revisado em 2026-11-01) ---
# API e servidor web carregam este .env da raiz. Ambiente exportado tem precedencia.
# Nunca versione o .env real nem use NEXT_PUBLIC_* para credenciais.
APP_ENV=local
DATABASE_URL=postgres://nucleos_dev@127.0.0.1:15432/nucleos_dev
DATABASE_PASSWORD=
# Use a senha do Postgres local ja criado; mudar este valor nao altera a senha no banco.
HOTMART_ENV=production
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
# Token Basic fornecido pela Hotmart, sem o prefixo "Basic ". Opcional para compatibilidade.
HOTMART_CLIENT_TOKEN=
HOTMART_SYNC_INTERVAL=30m
HOTMART_BACKFILL_DAYS=90
# Mesma chave privada na API e no servidor web; vazia => vendas fechadas (503).
VENDAS_API_KEY=
# Endereco da API INTERNA do NUCLEOS, consultada pelo servidor web.
# As URLs externas da Hotmart ficam no codigo; nao substitua esta URL por elas.
VENDAS_API_URL=http://127.0.0.1:3001
# APP_ENV=staging|production exige DATABASE_URL e DATABASE_PASSWORD (ou *_FILE).
# PORT=3001 REQUEST_TIMEOUT=30s SHUTDOWN_TIMEOUT=10s MAX_BODY_SIZE=1mb
# DATABASE_URL continua sem senha: use DATABASE_PASSWORD separadamente.
# Alternativa compativel: <NOME>_FILE=/run/secrets/<nome>, arquivo 0400/0600.
# Nao configure valor direto e *_FILE para a mesma credencial.

# Meta Ads: leitura por System User com ads_read, sem alteracoes de campanhas.
# Sem token ou conta, a tarefa do Gestor de Trafego fica indisponivel.
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# Alternativa: META_ADS_ACCESS_TOKEN_FILE=/run/secrets/meta_ads_access_token

# CFO: chaves privadas distintas. ANTHROPIC_API_KEY e usada somente no ai-gateway.
# Sem as credenciais, o CFO permanece indisponivel; nao ha chamada externa ficticia.
AI_GATEWAY_URL=http://127.0.0.1:8002
AI_GATEWAY_API_KEY=
CFO_LEITURA_API_KEY=
CFO_FINANCEIRO_API_URL=http://127.0.0.1:3001
ANTHROPIC_API_KEY=
# Todas as chaves acima aceitam *_FILE, sem configurar simultaneamente valor e arquivo.
CFO_MODELO=claude-sonnet-5-5
CFO_MAX_PASSOS=4
CFO_MAX_TOKENS=16000
CFO_MAX_SAIDA=2000
CFO_MAX_CUSTO_USD=0.25
