{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleos.invalid/contracts/job-envelope.schema.json",
  "x-schema-version": "1.0",
  "title": "JobEnvelope - envelope de job do Dispatcher para o runtime",
  "description": "Contrato do job entregue ao runtime (EP-05). O runtime recusa envelope cujo tenant_id difira do seu proprio. assignment_signature assina os campos canonicos (definicao em MSG-001).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "tenant_id",
    "type",
    "idempotency_key",
    "attempt",
    "issued_at",
    "expires_at",
    "correlation_id",
    "assignment_signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "Versao semantica do contrato (major.minor). Campo opcional novo = minor; remocao/mudanca = major."
    },
    "job_id": {
      "$ref": "#/$defs/uuid"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "assignment_signature": {
      "$ref": "#/$defs/assignment_signature"
    },
    "payload": {
      "type": "object",
      "description": "Corpo especifico do tipo de job; validado pelo contrato do tipo (fora deste envelope)."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "assignment_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "alg",
        "value"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "alg": {
          "const": "EdDSA"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
