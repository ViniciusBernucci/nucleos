{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleos.invalid/contracts/ai-completion-request.schema.json",
  "x-schema-version": "1.0",
  "title": "AiCompletionRequest - pedido de completion ao AI Gateway",
  "description": "Sem campo de tenant (derivado da identidade, EP-07). model_alias e um alias logico resolvido pelo gateway, nunca o identificador do provedor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "agent_id",
    "step_seq",
    "idempotency_key",
    "model_alias",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "Versao semantica do contrato (major.minor). Campo opcional novo = minor; remocao/mudanca = major."
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "agent_id": {
      "$ref": "#/$defs/uuid"
    },
    "step_seq": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "model_alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 200000
        }
      }
    }
  }
}
